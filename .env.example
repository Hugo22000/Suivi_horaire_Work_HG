# Copiez ce fichier en .env pour le développement local.
# Sur Vercel, DATABASE_URL et DATABASE_URL_UNPOOLED sont ajoutées automatiquement
# dès que vous liez une base "Neon" (Storage → Postgres) au projet depuis le
# dashboard Vercel. DATABASE_URL est la connexion poolée (utilisée par l'app),
# DATABASE_URL_UNPOOLED est la connexion directe (utilisée pour les migrations).

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez-en une avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"

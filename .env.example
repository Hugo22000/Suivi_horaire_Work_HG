# Copiez ce fichier en .env pour le développement local.
# Sur Vercel, ces variables sont ajoutées automatiquement dès que vous liez une
# base "Postgres" (Neon) au projet depuis l'onglet "Storage" du dashboard
# Vercel. Vérifiez qu'elles sont bien cochées pour l'environnement
# "Production" (pas seulement Preview/Development), sans quoi le build échoue.

# Connexion poolée (via pgbouncer) : utilisée par l'application à l'exécution.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# Connexion directe (sans pooler) : utilisée pour appliquer les migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez-en une avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"

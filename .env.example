# Copiez ce fichier en .env pour le développement local.
# Sur Vercel, renseignez NEON_POSTGRES_URL et NEON_POSTGRES_URL_NON_POOLING
# dans Settings → Environment Variables (à partir des valeurs fournies par
# l'intégration Neon), en vérifiant qu'elles sont bien cochées pour
# l'environnement "Production" (pas seulement Preview/Development), sans quoi
# le build échoue.

# Connexion poolée (via pgbouncer) : utilisée par l'application à l'exécution.
NEON_POSTGRES_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# Connexion directe (sans pooler) : utilisée pour appliquer les migrations.
NEON_POSTGRES_URL_NON_POOLING="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez-en une avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"

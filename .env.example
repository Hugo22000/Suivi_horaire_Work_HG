# Copiez ce fichier en .env pour le développement local.
# Sur Vercel, POSTGRES_PRISMA_URL et POSTGRES_URL_NON_POOLING sont ajoutées
# automatiquement dès que vous liez une base "Postgres" (Neon) au projet
# depuis l'onglet "Storage" du dashboard Vercel.

POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?schema=public&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?schema=public"

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez-en une avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"

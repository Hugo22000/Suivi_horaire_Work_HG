# Copiez ce fichier en .env pour le développement local.
# Sur Vercel, POSTGRES_URL (et DATABASE_URL / PRISMA_DATABASE_URL) sont ajoutées
# automatiquement dès que vous liez une base "Prisma Postgres" au projet
# depuis l'onglet "Storage" du dashboard Vercel. On utilise ici POSTGRES_URL,
# qui est une connexion PostgreSQL directe (sans passer par Prisma Accelerate).

POSTGRES_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Clé secrète utilisée pour signer les sessions de connexion.
# Générez-en une avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"
